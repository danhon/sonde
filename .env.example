# Traefik routing (set by the Makefile; the line here is documentation only —
# `make deploy` always overrides it)
SERVICE_HOST=sonde.sgc.rayandhon.com

# Host directory for nightly DB snapshots. On-box only — this guards against DB
# corruption, not against losing the host.
BACKUP_HOST_DIR=/home/danhon/sonde-backups

# Whose followers to track — handle or DID
BLUESKY_ACTOR=danhon.com

# Bluesky API
BLUESKY_API_BASE=https://public.api.bsky.app
# Cap is 3000 req / 5 min / IP and is shared house-wide with BlueBirdNET and
# atproto-labeler, so we sit well under it rather than at the arithmetic limit.
API_RATE_LIMIT_PER_SECOND=3
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# Cadence. The full sweep interval also sets unfollow latency: 2 sweeps = 12h.
HEAD_SWEEP_MINUTES=15
FULL_SWEEP_HOURS=6
PROFILE_TTL_DAYS=7

# Departure safety rails
DEPARTURE_CONFIRM_SWEEPS=2
MASS_DEPARTURE_PCT=2.0

# Display policy for followers who turned off logged-out visibility.
# false = show them, marked "private". true = count them, withhold from tables.
RESPECT_NO_UNAUTHENTICATED=false

# Storage — set by Dockerfile defaults; only override if needed
# DB_PATH=/data/sonde.db
# BACKUP_DIR=/backup
BACKUP_KEEP=14

TZ=America/Los_Angeles

# Lets the build stamp in the header say whether main has moved past what is
# deployed. The repository is private, so the check needs a credential — a
# fine-grained token with read-only Contents on this one repo is enough, and
# nothing here writes. Without it the panel still shows what is running and
# when, it just cannot say whether that is current.
# GITHUB_TOKEN=
# GITHUB_REPO=danhon/sonde
# GITHUB_BRANCH=main
