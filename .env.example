# Traefik routing (set by the Makefile; the line here is documentation only —
# `make deploy` always overrides it)
SERVICE_HOST=sonde.sgc.rayandhon.com

# Host directory for nightly DB snapshots. On-box only — this guards against DB
# corruption, not against losing the host.
BACKUP_HOST_DIR=/home/danhon/sonde-backups

# Whose followers to track — handle or DID
BLUESKY_ACTOR=danhon.com

# Bluesky API
BLUESKY_API_BASE=https://public.api.bsky.app
# Cap is 3000 req / 5 min / IP and is shared house-wide with BlueBirdNET and
# atproto-labeler, so we sit well under it rather than at the arithmetic limit.
API_RATE_LIMIT_PER_SECOND=3
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# Cadence. The full sweep interval also sets unfollow latency: 2 sweeps = 12h.
HEAD_SWEEP_MINUTES=15
FULL_SWEEP_HOURS=6
PROFILE_TTL_DAYS=7

# Departure safety rails
DEPARTURE_CONFIRM_SWEEPS=2
MASS_DEPARTURE_PCT=2.0

# The same rail on the follow list. A sweep that would drop more than this
# share of known follows is refused and the run is marked failed, because a
# sweep returning nothing used to wipe every follow URI sonde had created.
# Looser than the departure rail on purpose — unfollowing a handful of people
# is normal; losing a quarter of the list in one sweep is not.
MASS_UNFOLLOW_PCT=25.0

# Display policy for followers who turned off logged-out visibility.
# false = show them, marked "private". true = count them, withhold from tables.
RESPECT_NO_UNAUTHENTICATED=false

# Storage — set by Dockerfile defaults; only override if needed
# DB_PATH=/data/sonde.db
# BACKUP_DIR=/backup
BACKUP_KEEP=14

TZ=America/Los_Angeles

# Email. Leave SMTP_HOST blank and nothing is ever sent — the daily digest and
# the verified-arrival alerts both no-op quietly rather than erroring.
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
NOTIFY_TO=

# Instant email when a verified account (or a trusted verifier) follows you.
# Latency is one head sweep, so ~15 minutes; detection costs no API calls
# because verification rides along in the follower list the sweep already
# fetched.
ENABLE_VERIFIED_ALERTS=true
# Bounds the backlog after downtime: arrivals older than this are left to the
# daily digest rather than arriving all at once. Switching alerts on for the
# first time is silent regardless — it never reports what happened before it
# was enabled.
VERIFIED_ALERT_LOOKBACK_HOURS=48
VERIFIED_ALERT_MAX_LISTED=10
# Somewhere other than NOTIFY_TO, if alerts should go to a different inbox
# from the digest. Blank means the same place.
VERIFIED_ALERT_TO=

# Lets the build stamp in the header say whether main has moved past what is
# deployed. The repository is private, so the check needs a credential — a
# fine-grained token with read-only Contents on this one repo is enough, and
# nothing here writes. Without it the panel still shows what is running and
# when, it just cannot say whether that is current.
# GITHUB_TOKEN=
# GITHUB_REPO=danhon/sonde
# GITHUB_BRANCH=main
